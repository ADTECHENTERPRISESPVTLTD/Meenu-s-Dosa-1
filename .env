# Meenu's Dosa environment configuration

# Public API base URL (used by the frontend). Defaults to same-origin /api.
# Override for a separate backend, e.g. https://api.meenusdosa.com
NEXT_PUBLIC_API_URL=/api

# MongoDB connection string (optional). When set, all data persists to MongoDB.
# Leave empty to use the local file store (.db/store.json).
# Get one free at https://www.mongodb.com/cloud/atlas
MONGODB_URI=
MONGODB_DB_NAME=meenusdosa

# Restaurant metadata
NEXT_PUBLIC_SITE_NAME="Meenu's Dosa"
NEXT_PUBLIC_SITE_TAGLINE="40-year heritage of crafting crispy dosas and soda-free fluffy idlis."

# Backend server configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
ADDITIONAL_ALLOWED_ORIGINS=

# Admin credentials for seeding (only used during initial setup)
SEED_ADMIN_EMAIL=admin@meenusdosa.com
SEED_ADMIN_PASSWORD=MeenusDosa@Admin2026
SEED_ADMIN_NAME=Super Admin

# JWT
JWT_SECRET=meenus_dosa_jwt_secret_key_adtech_prod_2026_987654321
JWT_EXPIRES_IN=1d

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=200

# Messaging (optional)
WHATSAPP_PHONE_NUMBER=
WHATSAPP_API_TOKEN=
WHATSAPP_API_URL=https://linktr.ee/meenusdosa
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Trilio SMS (optional)
TRILIO_ACCOUNT_SID=
TRILIO_AUTH_TOKEN=
TRILIO_FROM_NUMBER=
TRILIO_API_URL=

# Delivery partner deep links (optional)
ZOMATO_URL=https://www.zomato.com/bhopal/meenus-dosa-ayodhya-bypass/
SWIGGY_URL=https://www.swiggy.com/city/bhopal/meenus-dosa-minal-minaal-residency-piplani-rest995939