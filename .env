# Meenu's Dosa frontend configuration

# Backend API URL.
# Default '/api' uses the built-in Next.js API routes (same project).
# For the standalone Express backend, set it to:
#   NEXT_PUBLIC_API_URL=http://localhost:4000/api
#   NEXT_PUBLIC_API_URL=https://your-backend-domain.com/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# MongoDB connection string (used by the standalone backend).
# Leave empty to use the local file store (.db/store.json).
# Get one free at https://www.mongodb.com/cloud/atlas
MONGODB_URI=
MONGODB_DB_NAME=meenusdosa

# Restaurant metadata
NEXT_PUBLIC_SITE_NAME="Meenu's Dosa"
NEXT_PUBLIC_SITE_TAGLINE="40-year heritage of crafting crispy dosas and soda-free fluffy idlis."

# Delivery partner deep links (optional overrides)
# NEXT_PUBLIC_ZOMATO_URL=https://www.zomato.com/bhopal/meenus-dosa-ayodhya-bypass/
# NEXT_PUBLIC_SWIGGY_URL=https://www.swiggy.com/city/bhopal/meenus-dosa-minal-minaal-residency-piplani-rest995939
# NEXT_PUBLIC_WHATSAPP_URL=https://linktr.ee/meenusdosa
# NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/meenusdosa